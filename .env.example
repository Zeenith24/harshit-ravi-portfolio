# Copy to .env and fill in. Never commit .env.

# Server-only Gemini key (free at https://aistudio.google.com/). Never prefix this with PUBLIC_.
GEMINI_API_KEY=

# Optional: your private notes, used instead of knowledge/Harshit_deets.md (handy on Vercel, where you can't keep
# the git-ignored file). Prefer the one-line base64 form: base64 -w0 knowledge/Harshit_deets.md
# KNOWLEDGE_DEETS_B64=
# or the raw multi-line text:
# KNOWLEDGE_DEETS=
