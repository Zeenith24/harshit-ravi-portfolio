# Copy to .env and fill in. Never commit .env.

# Server-only Gemini key (free at https://aistudio.google.com/). Never prefix this with PUBLIC_.
GEMINI_API_KEY=

# Optional: your private notes as ONE multi-line value, used instead of knowledge/Harshit_deets.md
# (handy on Vercel, where you can't keep the git-ignored file). Paste the file's whole contents.
# KNOWLEDGE_DEETS=
